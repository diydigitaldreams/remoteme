{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://remoteme.app/schemas/score_result.schema.json",
  "title": "ScoreResult",
  "description": "Structured output created when RemoteMe scores a job post against app-provided user inputs.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "fit_score",
    "recommendation",
    "why_this_fits",
    "risks",
    "remote_location_notes",
    "resume_angle",
    "cover_letter_angle",
    "questions_to_verify"
  ],
  "properties": {
    "fit_score": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "recommendation": {
      "type": "string",
      "enum": ["Strong Apply", "Apply", "Maybe", "Low Priority", "Skip"]
    },
    "score_breakdown": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "core_role_match": {"type": "integer", "minimum": 0, "maximum": 25},
        "skills_match": {"type": "integer", "minimum": 0, "maximum": 20},
        "experience_level_match": {"type": "integer", "minimum": 0, "maximum": 15},
        "remote_location_compatibility": {"type": "integer", "minimum": 0, "maximum": 15},
        "domain_interest": {"type": "integer", "minimum": 0, "maximum": 10},
        "compensation_seniority_alignment": {"type": "integer", "minimum": 0, "maximum": 5},
        "application_strength": {"type": "integer", "minimum": 0, "maximum": 5},
        "risk_adjustment": {"type": "integer", "minimum": -20, "maximum": 0}
      },
      "default": {}
    },
    "why_this_fits": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "minItems": 1
    },
    "risks": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "default": []
    },
    "remote_location_notes": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "default": []
    },
    "resume_angle": {
      "type": "string",
      "minLength": 1
    },
    "cover_letter_angle": {
      "type": "string",
      "minLength": 1
    },
    "questions_to_verify": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "default": []
    },
    "tracker_summary": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "company": {"type": "string"},
        "role": {"type": "string"},
        "remote_status": {"type": "string", "enum": ["remote", "hybrid", "onsite", "unclear"]},
        "location_risk": {"type": "string", "enum": ["none", "low", "medium", "high", "unclear"]},
        "fit_score": {"type": "integer", "minimum": 0, "maximum": 100},
        "recommendation": {"type": "string", "enum": ["Strong Apply", "Apply", "Maybe", "Low Priority", "Skip"]},
        "suggested_status": {"type": "string"},
        "notes": {"type": "string"}
      },
      "default": {}
    }
  }
}
